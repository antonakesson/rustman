{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "cargo run --release",
            "type": "node-terminal",
            "request": "launch",
            "command": "cargo run --release",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "rustman (debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/rustman.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "cargo build"
        },
        {
            "name": "rustman (release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/release/rustman.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "cargo build --release"
        }
    ]
}
